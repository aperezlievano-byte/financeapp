# Personal Finance App — plantilla de variables de entorno.
# Copia este archivo a .env (Bootstrap lo hace por ti) y rellena lo que falte.
#
# FORMATO: todos los valores van entre comillas simples. scripts/with-env.sh
# hace `. ./.env`, asi que un valor sin comillas con espacios rompe la carga.

# --- Identidad del unico usuario -------------------------------------------
# UUID del unico usuario. En produccion debe ser el auth.users.id real de
# Supabase (Supabase Dashboard > Authentication > Users > copiar el id).
# En local es un UUID fijo que usan el seed y los tests e2e.
APP_USER_ID='00000000-0000-0000-0000-000000000001'

# --- Base de datos ----------------------------------------------------------
# Local: el contenedor de docker-compose.yml (puerto 5433 en el host).
# Produccion: Supabase Dashboard > Project Settings > Database > Connection
# string. Usa la URL del POOLER para DATABASE_URL y la DIRECTA para
# DIRECT_DATABASE_URL (las migraciones no pueden correr por el pooler).
DATABASE_URL='postgresql://postgres:postgres@127.0.0.1:5433/personal_finance'
DIRECT_DATABASE_URL='postgresql://postgres:postgres@127.0.0.1:5433/personal_finance'

# Base de datos exclusiva de los tests. Nunca apunta a la de desarrollo.
TEST_DATABASE_URL='postgresql://postgres:postgres@127.0.0.1:5433/personal_finance_test'

# --- Supabase (auth y storage) ---------------------------------------------
# Supabase Dashboard > Project Settings > API.
# El valor local apunta a 127.0.0.1 a proposito: si no hay proyecto Supabase
# configurado, la llamada falla en milisegundos (ECONNREFUSED) y el guard
# trata la peticion como no autenticada en vez de colgarse en un DNS.
NEXT_PUBLIC_SUPABASE_URL='http://127.0.0.1:54321'
NEXT_PUBLIC_SUPABASE_ANON_KEY='local-placeholder-anon-key'

# Solo necesaria cuando STORAGE_DRIVER='supabase' (paso 14). Nunca llega al
# navegador. Supabase Dashboard > Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=''

# --- Almacenamiento de archivos --------------------------------------------
# 'local' escribe en disco bajo STORAGE_LOCAL_DIR (dev y tests).
# 'supabase' escribe en Supabase Storage (produccion, paso 14).
STORAGE_DRIVER='local'
STORAGE_LOCAL_DIR='.storage'

# --- Anthropic --------------------------------------------------------------
# console.anthropic.com > API Keys. Requerida desde el paso 5 en adelante para
# extraccion real; los tests inyectan un cliente falso y no la necesitan.
ANTHROPIC_API_KEY=''
# El id del modelo NUNCA se escribe en el codigo. Obtenlo invocando la skill
# claude-api (se activa sola) o desde docs.claude.com, y pegalo aqui.
ANTHROPIC_MODEL_ID=''

# --- Telegram ---------------------------------------------------------------
# Habla con @BotFather en Telegram: /newbot devuelve el token.
TELEGRAM_BOT_TOKEN=''
# Cadena aleatoria que tu eliges. Se envia en setWebhook y Telegram la repite
# en la cabecera X-Telegram-Bot-Api-Secret-Token de cada update.
TELEGRAM_WEBHOOK_SECRET='local-dev-secret'
# Tu chat id personal. Escribele a @userinfobot en Telegram y te lo dice.
# Es el unico remitente cuyos mensajes se procesan.
TELEGRAM_ALLOWED_CHAT_ID=''

# --- Despliegue (paso 14) ---------------------------------------------------
# URL publica del despliegue, sin barra final. Vercel > Project > Domains.
PRODUCTION_URL=''

# NOTA: E2E_DATABASE_URL y E2E_USER_ID NO van en este archivo ni en .env.
# playwright.config.ts es el unico lugar que las define, y por eso ningun
# archivo .env puede pisarlas. Ver blueprint.md seccion 10.
